@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant "r:EditRoleCommand" as Command LOGIC_COLOR
end box
participant "m:Model" as Model MODEL_COLOR
participant "s:Storage" as Storage STORAGE_COLOR

[-> Logic : execute(...)
activate Logic
Logic -> Parser : parseCommand(...)
activate Parser
ref over Parser, Command : RoleCommandParser validates syntax and creates r
Parser --> Logic : r
deactivate Parser
Logic -> Model : createRestorePoint()
activate Model
Model --> Logic : restore
deactivate Model
Logic -> Command : execute(m)
activate Command
Command -> Model : renameRole("Engineer", "Senior Engineer")
activate Model
note over Model
  Validate before applying.
  Keep role ID; update catalogue
  and all candidate references.
end note
Model --> Command
deactivate Model
Command --> Logic : CommandResult
deactivate Command
Logic -> Model : getAddressBook()
activate Model
Model --> Logic : addressBook
deactivate Model
Logic -> Storage : saveAddressBook(addressBook)
activate Storage
ref over Storage : Journal-coordinated candidate and catalogue save
Storage --> Logic
deactivate Storage
[<-- Logic : CommandResult
deactivate Logic
@enduml
